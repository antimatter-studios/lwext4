# SPDX-License-Identifier: BSD-3-Clause
# The API reference of the project site, from the public headers. Only
# what differs from Doxygen's defaults; ci/jobs/pages.sh adds the output
# directory and the version.
PROJECT_NAME           = lwext4
PROJECT_BRIEF          = "ext2/3/4 filesystem library for microcontrollers"
INPUT                  = include docs/site/api.md
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE                = include/misc
EXCLUDE_PATTERNS       = */generated/*
USE_MDFILE_AS_MAINPAGE = docs/site/api.md
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
SOURCE_BROWSER         = YES
HTML_OUTPUT            = .
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
